dev.db.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turbopack
.turbopack

# deployment
deploy/
deploy.tar.gz
*.tar.gz

/src/generated/prisma
nul/data

# uploaded files (stored in data directory in production)
/uploads

# local copies of uploaded photos — served from the server, NOT committed to git
# (keeps the .gitkeep placeholders so the folders still exist)
/public/uploads/**/*.jpg
/public/uploads/**/*.jpeg
/public/uploads/**/*.png
/public/uploads/**/*.webp
/public/uploads/**/*.gif
/public/uploads/**/*.avif

# archives & editor temp files
*.zip
*.tmp.*
recovered.tar.gz

# Local-only Moonlit comparison harness (37MB copy of the bought template)
/public/moonlit-ref/
