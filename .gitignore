/build
/.claude/
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# database files
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.backup*
*.sqlite
*.sqlite3
