/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/grouped
/recovered
# testing
/coverage
dev.db
# next.js
/.next/
/out/
/restored
