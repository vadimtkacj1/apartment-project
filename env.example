## Prisma (SQLite)
# For Prisma CLI commands (migrate, db push) when using Prisma v7+ config file.
DATABASE_URL="file:./dev.db"

## NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Public site URL used by NextAuth callbacks (must include protocol)
NEXTAUTH_URL="http://localhost:3000"

## Seed (optional)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

## Google Maps API
# Get your API key from: https://console.cloud.google.com/
# Enable "Maps JavaScript API" and "Geocoding API" for your project
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

## SEO Configuration
# Your website URL (used for sitemap, canonical URLs, Open Graph, etc.)
NEXT_PUBLIC_SITE_URL="https://ramnekasim.co.il"

## Search Engine Verification (Optional)
# Google Search Console verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
# Yandex Webmaster verification code
NEXT_PUBLIC_YANDEX_VERIFICATION=""


