// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// User model for authentication
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String // Hashed password
  name      String?
  email     String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact information (singleton)
model ContactInfo {
  id           Int      @id @default(autoincrement())
  phone        String
  phoneLink    String // tel: format
  phoneName    String? // Name for phone 1
  phone2       String? // Second phone number
  phoneLink2   String? // Second tel: format
  phoneName2   String? // Name for phone 2
  email        String
  emailLink    String // mailto: format
  email2       String? // Second email
  emailLink2   String? // Second mailto: format
  address      String
  city         String
  latitude     Float? // GPS latitude coordinate
  longitude    Float? // GPS longitude coordinate
  mapUrl       String?
  weekdayHours String // "ראשון - חמישי: 9:00 - 18:00"
  fridayHours  String // "שישי: 9:00 - 13:00"
  facebook     String?
  facebookName String? // Name for Facebook 1
  facebook2    String? // Second Facebook
  facebookName2 String? // Name for Facebook 2
  instagram    String?
  instagramName String? // Name for Instagram 1
  instagram2   String? // Second Instagram
  instagramName2 String? // Name for Instagram 2
  linkedin     String?
  whatsapp     String? // WhatsApp number
  whatsappName String? // Name for WhatsApp 1
  whatsapp2    String? // Second WhatsApp number
  whatsappName2 String? // Name for WhatsApp 2
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Property model for real estate listings
model Property {
  id Int @id @default(autoincrement())

  // Deal Type
  dealType String // 'sale' | 'rent'

  // Location
  city            String // 'holon' | 'batyam' | 'rishon' | 'telaviv'
  neighborhood    String?
  street          String?
  streetNumber    String?
  apartmentNumber String?
  latitude        Float? // GPS latitude coordinate
  longitude       Float? // GPS longitude coordinate

  // Property Details
  propertyType String // 'apartment' | 'garden-apartment' | 'cottage' | etc.
  floor        Int?
  totalFloors  Int? // Total number of floors in the building
  parking      String // 'none' | 'single' | 'double' | etc.
  position     String? // 'front' | 'back' | 'front-back' | 'side' | 'corner'
  furniture    String // 'none' | 'partial' | 'full'
  directions   String  @default("[]") // JSON array of directions: ['north', 'south', 'east', 'west']
  kitchen      String? // 'upgraded' | 'standard'

  // Measurements
  rooms       String
  area        Int
  builtArea   Int?
  balconySize Int? // גודל מרפסת שמש (Balcony Size in sqm)

  // Additional Info
  vacancyDate String?

  // Features (8 boolean fields)
  hasAirConditioning Boolean @default(false)
  hasDisabledAccess  Boolean @default(false)
  hasSunBalcony      Boolean @default(false)
  hasStorage         Boolean @default(false)
  hasSunroom         Boolean @default(false)
  hasBoiler          Boolean @default(false)
  hasSafeRoom        Boolean @default(false)
  hasElevator        Boolean @default(false)

  // Display Info
  title         String
  description   String
  price         String
  originalPrice String?
  images        String  @default("[]") // JSON array of image URLs
  status        String? // 'Exclusive' | 'New' | 'Opportunity' | etc.
  location      String // Display location (Hebrew)

  // For compatibility with old schema
  bedrooms  String // Same as rooms
  bathrooms Int    @default(1)

  // Category (for backward compatibility)
  category String? // 'sales' | 'rentals' | 'management' | 'land' | 'commercial'

  // Active status (for soft delete)
  isActive Boolean @default(true)

  // Sold status
  isSold Boolean @default(false)

  // Pin status (for home page display)
  isPinned Boolean @default(false)

  // Homepage section flags
  isHotProposition Boolean @default(false) // Show in Hot Propositions section
  isNoCommission   Boolean @default(false) // Show in No Commission section

  // Agent(s) for this property - JSON array of TeamMember IDs, e.g. "[1,2]"
  agentIds String @default("[]")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  views  PropertyView[]
  clicks ClickEvent[]

  // Indexes for better query performance
  @@index([city])
  @@index([dealType])
  @@index([propertyType])
  @@index([isActive])
  @@index([isSold])
  @@index([isPinned])
  @@index([isHotProposition])
  @@index([isNoCommission])
}

// Analytics: Property Views
model PropertyView {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // User information
  ipAddress String
  userAgent String?
  referer   String?

  // Session tracking
  sessionId String?

  // Location (if available)
  country String?
  city    String?
  region  String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([sessionId])
}

// Analytics: Click Events
model ClickEvent {
  id         Int       @id @default(autoincrement())
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Event details
  eventType   String // 'property_click', 'phone_click', 'email_click', 'whatsapp_click', 'contact_form', etc.
  elementId   String? // ID of clicked element
  elementType String? // 'button', 'link', 'card', etc.
  url         String? // URL where click happened

  // User information
  ipAddress String
  userAgent String?
  referer   String?

  // Session tracking
  sessionId String?

  // Location (if available)
  country String?
  city    String?
  region  String?

  // Additional metadata
  metadata String? // JSON string for additional data

  // Timestamps
  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([eventType])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([sessionId])
}

// Homepage section titles (singleton)
model HomepageSettings {
  id Int @id @default(autoincrement())

  // Section titles
  hotPropositionsTitle String @default("הצעות חמות")
  featuredPropertiesTitle String @default("נכסים באיזור המרכז")
  featuredPropertiesSubtitle String @default("מגוון דירות למכירה ולהשכרה אטרקטיביות באיזור המרכז")
  valuesSectionTitle String @default("למה לבחור בנו?")
  aboutSectionTitle String @default("אודות")
  processSectionTitle String @default("מה חשוב לדעת כשקונים נכס?")
  testimonialsTitle String @default("מה הלקוחות שלנו אומרים")
  noCommissionTitle String @default("דירה ללא עמלת תיווך")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Owner model - company owners/founders
model Owner {
  id            Int      @id @default(autoincrement())
  name          String
  title         String   // "מייסד ומתווך נדל״ן"
  image         String?  // Path to profile image
  phone         String?
  email         String?
  whatsapp      String?  // WhatsApp number
  licenceNumber String?  // License number
  description   String?
  order         Int      @default(0) // Display order
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

// Team member model - agents/employees
model TeamMember {
  id            Int      @id @default(autoincrement())
  name          String
  role          String   // "סוכן נדל״ן", "סוכנת נדל״ן"
  image         String?  // Path to profile image
  phone         String?
  mobile        String?
  whatsapp      String?  // WhatsApp number
  fax           String?
  email         String?
  licenceNumber String?  // License number
  description   String?
  order         Int      @default(0) // Display order
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}