# Production Environment Variables
# Копируйте этот файл в .env на сервере и заполните реальными значениями
# НЕ коммитьте .env файлы в git!

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Node.js Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NODE_ENV=production
PORT=80
HOSTNAME=0.0.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Application URLs
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Публичный URL вашего приложения
NEXT_PUBLIC_APP_URL=https://your-domain.com

# API URL (если отдельный)
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Database Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

DATABASE_URL="file:/var/lib/apartment-project/dev.db"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# File Uploads (ОБЯЗАТЕЛЬНО для production!)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Путь должен совпадать с nginx alias для /uploads/
# Без этого фото из админки сохраняются не туда → 404 на сайте
# UPLOADS_DIR=/opt/apartment-project/public/uploads

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
