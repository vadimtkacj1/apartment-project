# WHATSAPP_PHONE_NUMBER=+972XXXXXXXXX

# Telegram Bot (если используется)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Feature Flags
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ENABLE_MAINTENANCE_MODE=false
# ENABLE_ANALYTICS=true
# ENABLE_EMAIL_NOTIFICATIONS=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Logging & Monitoring
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn (для мониторинга ошибок)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Примечания:
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Создайте .env файл на сервере:
#    cp .env.production.example .env
#    nano .env
#
# 2. Никогда не коммитьте .env в git!
#    Он уже добавлен в .gitignore
#
# 3. Для генерации безопасных секретов:
#    openssl rand -base64 32
#
# 4. Проверьте, что .env загружается:
#    pm2 env apartment-project
#
# 5. После изменения .env перезапустите приложение:
#    pm2 restart apartment-project --update-env
