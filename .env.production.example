# EMAIL_TO=email1@example.com,email2@example.com
EMAIL_TO=vadim.tkach1378@gmail.com,misha.kaspler@gmail.com

# Alternative SMTP providers:
# Gmail: smtp.gmail.com (port 587, use App Password)
